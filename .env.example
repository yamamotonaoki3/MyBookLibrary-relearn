# Docker Compose（PostgreSQL）用の環境変数の例。
# このファイルを .env にコピーし、changeme を推測されにくい値に置き換える。
# .env は .gitignore 対象のためコミットされない。

POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mybooklibrary
POSTGRES_PORT=5432

# アプリ（Drizzle）からの接続文字列。上の値と合わせる。
DATABASE_URL=postgres://changeme:changeme@localhost:5432/mybooklibrary
